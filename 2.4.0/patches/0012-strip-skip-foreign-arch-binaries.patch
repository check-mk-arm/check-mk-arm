+# e_machine (EM_* in elf.h). Debian's binutils is built for the native target
+# only, so handing strip(1) a foreign-architecture binary fails outright with
+# "Unable to recognise the format of the input file". The tree legitimately
+# contains foreign binaries: everything under share/check_mk/agents is a payload
+# shipped for deployment to other hosts, not something that runs on the server.
+# On x86-64 hosts every binary is native, so nothing changes there.
+ELF_MACHINE_BY_HOST = {"x86_64": 0x3E, "aarch64": 0xB7}
+ELF_MACHINE_HOST = ELF_MACHINE_BY_HOST.get(platform.machine())
 
 
