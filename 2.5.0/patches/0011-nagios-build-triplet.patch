@@ -38,6 +38,11 @@
     ],
     configure_in_place = True,
     configure_options = [
+        # nagios 3.5.1 (2013) ships config.guess from 2006, which predates
+        # aarch64 and aborts configure with "cannot guess build type". Naming
+        # the build triplet explicitly skips config.guess entirely; config.sub,
+        # which canonicalises what we pass here, already knows aarch64.
+        "--build=aarch64-unknown-linux-gnu",
         "--with-nagios-user=$$(id -un)",
         "--with-nagios-group=$$(id -gn)",
         "--with-perlcache",
