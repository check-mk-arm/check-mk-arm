--- bazel/module/py.MODULE.bazel
+++ bazel/module/py.MODULE.bazel
@@ -7,6 +7,23 @@
         "https://github.com/astral-sh/python-build-standalone/releases/download/20260610/cpython-3.13.14+20260610-x86_64-unknown-linux-gnu-install_only.tar.gz",
     ],
 )
+
+# rules_python 1.4.1 does not know any of the CPython patch levels pinned here;
+# the x86_64 overrides are the only reason they resolve at all, so on aarch64
+# there is no interpreter to register and the pip extension fails with
+# "Unable to find interpreter for pip hub ... Make sure a corresponding
+# python.toolchain() call exists". Each block below adds the aarch64 asset from
+# the same python-build-standalone release. 3.13 is the interpreter that ends up
+# driving the build; the rest exist only to test the agent plugins against older
+# Pythons, but the extension evaluates them regardless of the target being built.
+python.single_version_platform_override(
+    platform = "aarch64-unknown-linux-gnu",
+    python_version = "3.13.14",
+    sha256 = "fe5b366ecf26fe565113b195a03ea18d7030f2dab691c0bed41cf19318100be2",
+    urls = [
+        "https://github.com/astral-sh/python-build-standalone/releases/download/20260610/cpython-3.13.14+20260610-aarch64-unknown-linux-gnu-install_only.tar.gz",
+    ],
+)
 python.defaults(python_version = "3.13")
 python.toolchain(
     configure_coverage_tool = True,
@@ -56,6 +73,14 @@
