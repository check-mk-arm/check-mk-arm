+def _add_aarch64_build_profile(repository_ctx):
+    """Derive build/unix/aarch64_linux.mk from upstream's arm_v6_linux.mk.
+
+    snap7 ships one makefile per architecture and 1.4.2 has no aarch64 profile
+    (i386, x86_64, arm_v6, arm_v7, mips only). The arm_v6 one differs from the
+    aarch64 one purely in the string "arm_v6", which names the output directory
+    and the target: the compiler is the plain host g++ either way. This is the
+    same derivation Checkmk's own commented-out `snap7-repackage` target did.
+    """
+    src = repository_ctx.path("build/unix/arm_v6_linux.mk")
+    if not src.exists:
+        fail("snap7 archive has no build/unix/arm_v6_linux.mk to derive aarch64 from")
+    repository_ctx.file(
+        "build/unix/aarch64_linux.mk",
+        repository_ctx.read(src).replace("arm_v6", "aarch64"),
+        executable = False,
+    )
+
 def _snap7_repository_impl(repository_ctx):
     """Implementation of the snap7 repository rule."""
 
